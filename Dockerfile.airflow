# Extends the official Airflow image so its BashOperator tasks can run
# our EXISTING extract.py / transform.py / load.py scripts directly -
# no pipeline logic is duplicated or rewritten for Airflow specifically.
FROM apache/airflow:3.3.1

COPY extractor/requirements.txt /tmp/extractor-requirements.txt
COPY transform/requirements.txt /tmp/transform-requirements.txt
COPY loader/requirements.txt /tmp/loader-requirements.txt

# Pinning apache-airflow to the same version as the base image is
# Airflow's own documented pattern for adding extra requirements - it
# stops pip from trying to upgrade/downgrade Airflow itself while
# installing our pipeline's dependencies alongside it.
RUN pip install --no-cache-dir apache-airflow==3.3.1 \
    -r /tmp/extractor-requirements.txt \
    -r /tmp/transform-requirements.txt \
    -r /tmp/loader-requirements.txt

# The pipeline code itself - copied to a clearly separate path from
# Airflow's own internals, so it's obvious this is OUR code being
# orchestrated, not something baked into Airflow.
COPY extractor/ /opt/airflow/pipeline/extractor/
COPY transform/ /opt/airflow/pipeline/transform/
COPY loader/ /opt/airflow/pipeline/loader/
