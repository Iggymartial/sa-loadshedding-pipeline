# Copy this file to .env and fill in your real token.
# Never commit the real .env file - it's already in .gitignore.

# Get a free token by registering at https://eskomsepush.gumroad.com/l/api
ESP_API_TOKEN=your-token-here

# The provider has moved API versions before (2.0 was retired in favour of
# 3.0/3.1). Confirmed current base URL from their own Getting Started docs.
ESP_API_BASE_URL=https://developer.sepush.co.za/business/3.1

# MySQL connection - these defaults match docker-compose.yml, so if you're
# running the database via `docker compose up`, you don't need to change
# anything here. Only override MYSQL_HOST if MySQL is running somewhere
# other than your local machine.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=loadshedding
MYSQL_USER=pipeline_user
MYSQL_PASSWORD=pipeline_password
MYSQL_ROOT_PASSWORD=rootpassword
